# Local development — copy to .env and fill in.
# On Railway, MYSQL* vars are injected by the MySQL plugin.
# Set JUDGE_PASSWORD_HASH, Resend, and S3 vars in the Railway dashboard.

# MySQL (Railway injects these; for local use the same names)
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=florida_sound_quality

# bcrypt hash of the judge login password
JUDGE_PASSWORD_HASH=

# --- Mail: Resend (preferred; same pattern as estateGuard) ---
# EMAIL_FROM is accepted as an alias for MAIL_FROM
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
MAIL_FROM=olawale@mail.rekkeh.com
MAIL_FROM_NAME="Florida Sound Quality"

# Optional SMTP fallback (e.g. Resend SMTP: smtp.resend.com / user=resend / pass=API key)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_SECURE=tls

# --- Railway S3-compatible bucket (server-side PDF archive only; no client upload) ---
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
