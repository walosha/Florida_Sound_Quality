# Local development — copy to .env and fill in.
# On Railway, MYSQL* vars are injected automatically by the MySQL plugin.
# Set JUDGE_PASSWORD_HASH, SMTP_*, and MAIL_FROM in the Railway dashboard.

# MySQL (Railway injects these; for local use the same names)
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=florida_sound_quality

# Or a single URL (used if MYSQLHOST is unset):
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/florida_sound_quality

# bcrypt hash of the judge login password (generate with:
#   php -r "echo password_hash('your-password', PASSWORD_BCRYPT), PHP_EOL;")
# Local/Railway test password used in Phase 1: judge123
JUDGE_PASSWORD_HASH=

# SMTP (used in Phase 4)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Florida Sound Quality"
